    "auth": {
      "type": "apikey",
      "apikey": [
        {
          "key": "key",
          "value": "api-key",
          "type": "string"
        },
        {
          "key": "value",
          "value": "postmanrulz",
          "type": "string"
        },
        {
          "key": "in",
          "value": "header",
          "type": "string"
        }
      ]
    },
    "variable": [
      {
        "key": "baseUrl",
        "value": "https://library-api.postmanlabs.com",
        "type": "string"
      },
      {
        "key": "skillcheckBaseUrl",
        "value": "https://postman-echo.com",
        "type": "string"
      },
      {
        "key": "id",
        "value": "1",
        "type": "string"
      },
      {
        "key": "favoriteActor",
        "value": "Leonardo DiCaprio",
        "type": "string"
      }
    ],
    "item": [
      {
        "name": "get books",
        "request": {
          "method": "GET",
          "header": [],
          "url": {
            "raw": "{{baseUrl}}/books",
            "host": [
              "{{baseUrl}}"
            ],
            "path": [
              "books"
            ]
          }
        },
        "response": []
      },
      {
        "name": "get fiction books",
        "request": {
          "method": "GET",
          "header": [],
          "url": {
            "raw": "{{baseUrl}}/books?genre=fiction&checkedOut=false",
            "host": [
              "{{baseUrl}}"
            ],
            "path": [
              "books"
            ],
            "query": [
              {
                "key": "genre",
                "value": "fiction"
              },
              {
                "key": "checkedOut",
                "value": "false"
              }
            ]
          }
        },
        "response": []
      },
      {
        "name": "get book by id",
        "request": {
          "method": "GET",
          "header": [],
          "url": {
            "raw": "{{baseUrl}}/books/:id",
            "host": [
              "{{baseUrl}}"
            ],
            "path": [
              "books",
              ":id"
            ],
            "variable": [
              {
                "key": "id",
                "value": "1"
              }
            ]
          }
        },
        "response": []
      },
      {
        "name": "add a book",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json",
              "type": "text"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"title\": \"The Pragmatic Programmer\",\n  \"author\": \"Andrew Hunt and David Thomas\",\n  \"genre\": \"technology\",\n  \"yearPublished\": 1999\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/books",
            "host": [
              "{{baseUrl}}"
            ],
            "path": [
              "books"
            ]
          }
        },
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Status code is 201\", function () {",
                "    pm.response.to.have.status(201);",
                "});",
                "let res = pm.response.json();",
                "pm.collectionVariables.set(\"id\", res.id);"
              ]
            }
          }
        ],
        "response": []
      },
      {
        "name": "checkout a book",
        "request": {
          "method": "PATCH",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json",
              "type": "text"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"checkedOut\": true\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/books/:id",
            "host": [
              "{{baseUrl}}"
            ],
            "path": [
              "books",
              ":id"
            ],
            "variable": [
              {
                "key": "id",
                "value": "1"
              }
            ]
          }
        },
        "response": []
      },
      {
        "name": "delete a book",
        "request": {
          "method": "DELETE",
          "header": [],
          "url": {
            "raw": "{{baseUrl}}/books/:id",
            "host": [
              "{{baseUrl}}"
            ],
            "path": [
              "books",
              ":id"
            ],
            "variable": [
              {
                "key": "id",
                "value": "1"
              }
            ]
          }
        },
        "response": []
      },
      {
        "name": "skill check",
        "request": {
          "auth": {
            "type": "apikey",
            "apikey": [
              {
                "key": "key",
                "value": "student-expert",
                "type": "string"
              },
              {
                "key": "value",
                "value": "skillcheck",
                "type": "string"
              },
              {
                "key": "in",
                "value": "header",
                "type": "string"
              }
            ]
          },
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json",
              "type": "text"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"actorName\": \"Leonardo DiCaprio\"\n}"
          },
          "url": {
            "raw": "{{skillcheckBaseUrl}}/post?movieName=Inception",
            "host": [
              "{{skillcheckBaseUrl}}"
            ],
            "path": [
              "post"
            ],
            "query": [
              {
                "key": "movieName",
                "value": "Inception"
              }
            ]
          }
        },
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "let responseData = pm.response.json();",
                "pm.collectionVariables.set(\"favoriteActor\", responseData.json.actorName);"
              ]
            }
          }
        ],
        "response": []
      }
    ]
  }
}