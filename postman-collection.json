{
  "collection": {
    "info": {
      "_postman_id": "7a8b9c0d-1e2f-3a4b-5c6d-7e8f9a0b1c2d",
      "name": "Postman Library API v2",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
